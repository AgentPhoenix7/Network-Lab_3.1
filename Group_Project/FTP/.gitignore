# Runtime files used by the examples (keep tracked demo sample files)
/server-data/*
!/server-data/samples/
!/server-data/samples/**
!/server-data/welcome.txt
/downloads/
/app-data/

# Small, requested benchmark reports are deliverables (large media is generated locally)
!/benchmarks/results/*.png
!/benchmarks/results/*.json

# Python integration-test caches and optional environment
__pycache__/
*.py[cod]
/.venv/
.pytest_cache/
.coverage
htmlcov/

# Local environment and session logs
.env
.env.*
!.env.example
*.log

# Reproducible local test and benchmark outputs
/build/
/benchmarks/generated-media/
/benchmarks/generated-results/
