# Runtime files used by the examples
/server-data/
/downloads/
/app-data/

# Small, requested benchmark reports are deliverables (large media stays in .scratch)
!/benchmarks/results/*.png
!/benchmarks/results/*.json

# Python integration-test caches and optional environment
__pycache__/
*.py[cod]
/.venv/
.pytest_cache/
.coverage
htmlcov/

# Local environment and session logs
.env
.env.*
!.env.example
*.log
